# Copia este archivo como .env.local para el desarrollo local.
# No agregues claves reales a este archivo ni al repositorio.

# Firebase Web: datos de configuración de la aplicación web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Funciones HTTP opcionales. Vacías, la interfaz puede operar sin estas funciones.
VITE_AI_PROXY_URL=
VITE_AI_MODEL=gpt-4o-mini
VITE_AI_CLAUDE_URL=

# Configuración opcional de la interfaz.
VITE_MAIN_APP_URL=http://localhost:5173

# Secretos solo para servidor local (no usar prefijo VITE_).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Ruta local a credenciales de Firebase Admin; no pegues aquí la clave privada.
GOOGLE_APPLICATION_CREDENTIALS=
# Alternativa para MCP: JSON de cuenta de servicio codificado en base64.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Entorno explícito: staging o production para despliegues reales.
VITE_APP_ENV=staging
# Solo para desarrollo local con proyecto ficticio demo- y navegador local.
VITE_USE_EMULATORS=false
