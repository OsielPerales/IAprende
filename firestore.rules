rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function callerRole() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }
    function isMaestroOrAdmin() {
      return isAuth() && callerRole() in ['maestro', 'admin'];
    }
    function isAdmin() { return isAuth() && callerRole() == 'admin'; }
    function validProfile(userId) {
      return request.resource.data.keys().hasOnly(['id', 'email', 'nombre', 'apellido', 'rol', 'avatar_url', 'created_at'])
        && request.resource.data.id == userId
        && request.resource.data.rol in ['alumno', 'maestro', 'admin']
        && request.resource.data.nombre is string && request.resource.data.apellido is string
        && request.resource.data.email is string && request.resource.data.created_at is string;
    }
    match /usuarios/{userId} {
      allow read: if isAuth();
      // A public registration can never bootstrap its own privileged role.
      allow create: if isAuth() && validProfile(userId) && (
        (request.auth.uid == userId && request.resource.data.rol == 'alumno') || isAdmin()
      );
      allow update: if isAuth() && validProfile(userId) && (
        isAdmin() || (request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'apellido', 'avatar_url']))
      );
      allow delete: if false;
    }
    // Teachers manage the single institution; organization/tenant isolation is not implemented.
    match /cursos/{id} { allow read: if isAuth(); allow write: if isMaestroOrAdmin(); }
    match /bloques/{id} { allow read: if isAuth(); allow write: if isMaestroOrAdmin(); }
    match /grupos/{id} { allow read: if isAuth(); allow write: if isMaestroOrAdmin(); }
    match /grupo_alumnos/{id} { allow read: if isAuth(); allow write: if isMaestroOrAdmin(); }
    match /curso_grupos/{id} { allow read: if isAuth(); allow write: if isMaestroOrAdmin(); }
    match /respuestas/{id} {
      allow read: if isAuth() && (resource.data.alumno_id == request.auth.uid || isMaestroOrAdmin());
      allow create: if isAuth() && request.resource.data.alumno_id == request.auth.uid
        && request.resource.data.keys().hasOnly(['bloque_id', 'alumno_id', 'respuestas', 'calificacion', 'enviado_at'])
        && request.resource.data.bloque_id is string && request.resource.data.respuestas is map
        && request.resource.data.enviado_at is string && request.resource.data.calificacion == null;
      allow update: if isMaestroOrAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['calificacion', 'feedback_maestro'])
        && (request.resource.data.calificacion == null ||
          (request.resource.data.calificacion is number && request.resource.data.calificacion >= 0 && request.resource.data.calificacion <= 100));
      allow delete: if false;
    }
    match /alumno_analytics/{alumnoId} {
      allow read: if isAuth() && (request.auth.uid == alumnoId || isMaestroOrAdmin());
      allow write: if false;
    }
    match /notificaciones/{id} {
      allow read: if isAuth() && resource.data.destinatario_id == request.auth.uid;
      allow update: if isAuth() && resource.data.destinatario_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida'])
        && request.resource.data.leida is bool;
      allow create, delete: if false;
    }
    match /progreso_alumno/{id} {
      allow get: if isAuth() && (!exists(/databases/$(database)/documents/progreso_alumno/$(id))
        || resource.data.userId == request.auth.uid || isMaestroOrAdmin());
      allow list: if isAuth() && (resource.data.userId == request.auth.uid || isMaestroOrAdmin());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid
        && request.resource.data.cursoId is string
        && id == request.auth.uid + '_' + request.resource.data.cursoId;
      allow update: if isAuth() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.cursoId == resource.data.cursoId;
      allow delete: if false;
    }
    match /solicitudes_inscripcion/{id} {
      allow read: if isAuth() && (resource.data.alumno_id == request.auth.uid || isMaestroOrAdmin());
      allow create: if isAuth() && request.resource.data.alumno_id == request.auth.uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.grupo_id is string
        && id == request.resource.data.grupo_id + '_' + request.auth.uid;
      allow update: if isAuth() && request.resource.data.alumno_id == resource.data.alumno_id
        && request.resource.data.grupo_id == resource.data.grupo_id && (
          (isMaestroOrAdmin() && request.resource.data.estado in ['aprobada', 'rechazada']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'updated_at'])) ||
          (resource.data.alumno_id == request.auth.uid && resource.data.estado == 'rechazada'
            && request.resource.data.estado == 'pendiente'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'mensaje', 'created_at', 'updated_at']))
        );
      allow delete: if false;
    }
    match /caso_etico_respuestas/{id} {
      // Collaborative responses are deliberately readable within the institution.
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid
        && request.resource.data.bloque_id is string && id == request.resource.data.bloque_id + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'bloque_id', 'respuestas', 'created_at'])
        && request.resource.data.respuestas is list;
      allow update: if isAuth() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId && request.resource.data.bloque_id == resource.data.bloque_id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respuestas', 'created_at'])
        && request.resource.data.respuestas is list;
      allow delete: if false;
    }
    match /ai_usage/{id} { allow read, write: if false; }
  }
}
