rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: obtiene el rol del usuario que realiza la petición.
    // Firestore evalúa este get() de forma perezosa y lo cachea dentro de la misma petición.
    function callerRole() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol
    }

    function isAuth() {
      return request.auth != null
    }

    function isMaestroOrAdmin() {
      return isAuth() && callerRole() in ['maestro', 'admin']
    }

    function isAdmin() {
      return isAuth() && callerRole() == 'admin'
    }

    // ── Usuarios ──
    match /usuarios/{userId} {
      // Cualquier usuario autenticado puede leer (para listas de maestros, compañeros de grupo, etc.)
      allow read: if isAuth()
      // El mismo usuario crea su documento en el flujo de registro.
      allow create: if isAuth() && request.auth.uid == userId
      // Un usuario actualiza su propio perfil O un admin actualiza cualquier usuario (cambios de rol).
      allow update: if isAuth() && (request.auth.uid == userId || isAdmin())
      // Nadie puede borrar usuarios desde el cliente.
      allow delete: if false
    }

    // ── Cursos ──
    match /cursos/{cursoId} {
      allow read: if isAuth()
      // Solo maestros o admins pueden crear, modificar o borrar cursos.
      allow write: if isMaestroOrAdmin()
    }

    // ── Bloques ──
    match /bloques/{bloqueId} {
      allow read: if isAuth()
      // Solo maestros o admins pueden crear o editar contenido.
      allow write: if isMaestroOrAdmin()
    }

    // ── Grupos ──
    match /grupos/{grupoId} {
      allow read: if isAuth()
      // Solo maestros o admins pueden gestionar grupos.
      allow write: if isMaestroOrAdmin()
    }

    // ── Grupo-Alumnos (Inscripciones) ──
    match /grupo_alumnos/{inscripcionId} {
      allow read: if isAuth()
      // Solo maestros o admins pueden inscribir o remover alumnos.
      allow write: if isMaestroOrAdmin()
    }

    // ── Respuestas de Cuestionarios ──
    match /respuestas/{respuestaId} {
      // Un alumno lee sus propias respuestas; maestros y admins leen todas.
      allow read: if isAuth() && (
        resource.data.alumno_id == request.auth.uid || isMaestroOrAdmin()
      )
      // Un alumno solo puede crear respuestas atribuidas a sí mismo.
      allow create: if isAuth() && request.resource.data.alumno_id == request.auth.uid
      // Solo maestros o admins pueden actualizar (calificar).
      allow update: if isMaestroOrAdmin()
      // Nadie puede borrar respuestas desde el cliente.
      allow delete: if false
    }

    // ── SP4: Analytics de alumno ──────────────────────────────────────────────
    match /alumno_analytics/{alumnoId} {
      // El propio alumno lee su análisis; maestros y admins leen todos.
      allow read: if isAuth() && (
        request.auth.uid == alumnoId || isMaestroOrAdmin()
      )
      // Solo Cloud Functions (Admin SDK) escriben — nunca desde el cliente.
      allow write: if false
    }

    // ── SP6: Notificaciones inteligentes ──────────────────────────────────────
    match /notificaciones/{notifId} {
      // Solo el destinatario puede leer su notificación.
      allow read: if isAuth() && resource.data.destinatario_id == request.auth.uid
      // El destinatario puede marcarla como leída (update solo campo `leida`).
      allow update: if isAuth()
        && resource.data.destinatario_id == request.auth.uid
        && request.resource.data.keys().hasOnly(['leida'])
      // Solo Cloud Functions crean notificaciones.
      allow create, delete: if false
    }

    // ── Progreso del Alumno ────────────────────────────────────────────────────
    match /progreso_alumno/{docId} {
      // El alumno lee su propio progreso; maestros y admins leen todos.
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isMaestroOrAdmin()
      )
      // El alumno crea su propio documento de progreso.
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid
      // El alumno actualiza solo su propio progreso.
      allow update: if isAuth() && resource.data.userId == request.auth.uid
      // Nadie puede borrar progreso desde el cliente.
      allow delete: if false
    }

    // ── Solicitudes de inscripción a grupos ───────────────────────────────────
    match /solicitudes_inscripcion/{solicitudId} {
      // El alumno ve sus propias; maestros y admins ven todas.
      allow read: if isAuth() && (
        resource.data.alumno_id == request.auth.uid || isMaestroOrAdmin()
      )
      // Un alumno crea su solicitud a su nombre.
      allow create: if isAuth() && request.resource.data.alumno_id == request.auth.uid
      // Maestros y admins aprueban o rechazan.
      allow update: if isMaestroOrAdmin()
      allow delete: if false
    }

    // ── Asignaciones curso-grupo ───────────────────────────────────────────────
    match /curso_grupos/{asignacionId} {
      allow read: if isAuth()
      allow write: if isMaestroOrAdmin()
    }

    // ── Respuestas de Caso Ético (colaborativas) ───────────────────────────────
    match /caso_etico_respuestas/{docId} {
      // Cualquier usuario autenticado puede leer (para ver las respuestas del grupo).
      allow read: if isAuth()
      // Cualquier alumno puede crear o actualizar su propia respuesta.
      allow create, update: if isAuth()
      // Nadie puede borrar respuestas.
      allow delete: if false
    }

  }
}
